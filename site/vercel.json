{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/navi.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"navi-0.1.0.zip\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
