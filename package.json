{
  "name": "navi-voice-browser-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Navi: navigate Chrome hands-free with your voice.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "bench": "npm run build && node scripts/bench.mjs",
    "bench:mock": "npm run build && node scripts/bench.mjs --mock",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "1.18.0",
    "onnxruntime-web-1-20": "npm:onnxruntime-web@1.20.0",
    "pocket-tts-js": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
